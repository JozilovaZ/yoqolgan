# Bu faylni nusxalab, nomini .env qiling va qiymatlarni to'ldiring

# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Admin guruh ID si (botni guruhga qo'shib, /id yozing). -100 bilan boshlanadi
ADMIN_GROUP_ID=-1001234567890

# Kanal: @kanal_nomi yoki -100... (bot kanalda ADMIN bo'lishi shart)
CHANNEL_ID=@yoqolgan_narsalar_kanal
# Ixtiyoriy: kanal havolasi (yopiq kanal bo'lsa)
CHANNEL_LINK=

# Savollar uchun admin
ADMIN_USERNAME=@admin_username

# To'lov
SERVICE_FEE=50000
FINDER_SHARE=50
CARD_NUMBER=8600 0000 0000 0000
CARD_OWNER=Ism Familiya
# Onlayn to'lov (Click/Payme): @BotFather -> botingiz -> Payments. Bo'sh bo'lsa — karta + chek
PAYMENT_PROVIDER_TOKEN=

# true: hujjat egasining javobi OCR bilan tekshiriladi, mos kelsa avtomatik tasdiqlanadi
AUTO_VERIFY_DOCUMENTS=true

# true: darhol kanalga chiqadi, false: avval admin tasdiqlaydi
AUTO_PUBLISH=true

# ---------- Faqat nginx + webhook rejimi uchun (DEPLOY.md) ----------
# Domen (DNS'da server IP siga yo'naltirilgan bo'lishi kerak)
DOMAIN=
# SSL sertifikat uchun email
LETSENCRYPT_EMAIL=
# To'ldirilsa bot webhook rejimida ishlaydi: https://DOMAIN
WEBHOOK_URL=
# Ixtiyoriy maxfiy kalit (faqat harf, raqam, _ va -)
WEBHOOK_SECRET=
